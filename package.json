{
  "name": "opencode-native",
  "displayName": "OpenCode Native",
  "description": "An unofficial, community-built native VS Code sidebar for the OpenCode CLI, with streaming chat, sessions, models, agents, and trusted workspace context.",
  "version": "0.2.1",
  "publisher": "amr-elzoghby",
  "repository": {
    "type": "git",
    "url": "https://github.com/amr-elzoghby/OpenCode-Native.git"
  },
  "homepage": "https://github.com/amr-elzoghby/OpenCode-Native/tree/main",
  "bugs": {
    "url": "https://github.com/amr-elzoghby/OpenCode-Native/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "opencode",
    "ai",
    "coding agent",
    "chat",
    "assistant",
    "sidebar",
    "workspace",
    "remote",
    "wsl"
  ],
  "pricing": "Free",
  "activationEvents": [
    "onView:opencode.sidebar"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "OpenCode Native",
      "properties": {
        "opencode.native.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to an OpenCode CLI executable. Leave empty to use the first opencode executable on the Extension Host PATH."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode",
          "title": "OpenCode",
          "icon": "images/button-dark.svg"
        }
      ]
    },
    "views": {
      "opencode": [
        {
          "type": "webview",
          "id": "opencode.sidebar",
          "name": "Chat",
          "contextualTitle": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.openTerminal",
        "title": "Open opencode",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Open opencode in new tab",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.native.history",
        "title": "OpenCode: History",
        "icon": "$(history)"
      },
      {
        "command": "opencode.native.usage",
        "title": "OpenCode: Chat Tokens",
        "icon": "$(pie-chart)"
      },
      {
        "command": "opencode.native.refresh",
        "title": "OpenCode: Refresh Current Chat",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.native.newChat",
        "title": "OpenCode: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "opencode.native.focus",
        "title": "OpenCode: Focus"
      },
      {
        "command": "opencode.native.models",
        "title": "OpenCode: Models"
      },
      {
        "command": "opencode.native.agents",
        "title": "OpenCode: Agents"
      },
      {
        "command": "opencode.native.variants",
        "title": "OpenCode: Variants"
      },
      {
        "command": "opencode.native.stop",
        "title": "OpenCode: Stop"
      },
      {
        "command": "opencode.native.addExplorerFiles",
        "title": "Add to OpenCode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode.openNewTerminal",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "opencode.native.addExplorerFiles",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "2_workspace@50"
        }
      ],
      "view/title": [
        {
          "command": "opencode.native.history",
          "when": "view == opencode.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "opencode.native.refresh",
          "when": "view == opencode.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "opencode.native.usage",
          "when": "view == opencode.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "opencode.native.newChat",
          "when": "view == opencode.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.native.newChat",
        "key": "alt+n",
        "when": "opencode.native.sidebarFocused && !inQuickOpen"
      },
      {
        "command": "opencode.native.refresh",
        "key": "alt+r",
        "when": "opencode.native.sidebarFocused && !inQuickOpen"
      },
      {
        "command": "opencode.native.history",
        "key": "alt+h",
        "when": "opencode.native.sidebarFocused && !inQuickOpen"
      },
      {
        "command": "opencode.native.models",
        "key": "alt+m",
        "when": "opencode.native.sidebarFocused && !inQuickOpen"
      },
      {
        "command": "opencode.native.agents",
        "key": "alt+a",
        "when": "opencode.native.sidebarFocused && !inQuickOpen"
      },
      {
        "command": "opencode.native.stop",
        "key": "escape",
        "when": "opencode.native.composerFocused && opencode.native.generating"
      },
      {
        "command": "opencode.openTerminal",
        "title": "Run opencode",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Run opencode",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      }
    ]
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.18",
    "marked": "18.0.9"
  },
  "scripts": {
    "vscode:prepublish": "bun run bundle",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "bundle": "bun run check-types && bun run lint && node esbuild.js --production",
    "package": "bun run bundle && node script/package-vsix.mjs && bun run test:vsix",
    "package:vsix": "bun run package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vscode-test",
    "test:vsix": "bun run script/verify-vsix.mjs"
  },
  "devDependencies": {
    "@types/vscode": "1.106.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "esbuild": "^0.25.12",
    "jszip": "3.10.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0"
  }
}
